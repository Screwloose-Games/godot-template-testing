[gd_scene load_steps=2 format=3]

; The readout hides with H (%Panel). The cargo marker is a SIBLING of the panel,
; not a child, so it survives that toggle -- it is not debug output, it is the
; only way to know where the crate is when it is behind the camera.

[ext_resource type="Script" path="tether_hud.gd" id="1_hud"]

[node name="TetherHud" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Panel" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Readout" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 24.0
offset_top = 18.0
offset_right = 700.0
offset_bottom = 210.0

[node name="Banner" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -70.0
offset_right = 360.0
offset_bottom = 70.0
horizontal_alignment = 1
vertical_alignment = 1

[node name="Marker" type="Label" parent="."]
unique_name_in_owner = true
offset_right = 132.0
offset_bottom = 30.0
text = "<> CARGO"
horizontal_alignment = 1
vertical_alignment = 1
