[gd_scene load_steps=2 format=3]

; Wrapper for verify_cargo_tether_runtime.gd. It HAS to be a scene: the suite
; needs _ready() and real physics frames, and a node added during
; SceneTree._initialize() gets neither. Run the .gd with --script instead and it
; reports nothing and exits 0, which looks exactly like a pass.

[ext_resource type="Script" path="verify_cargo_tether_runtime.gd" id="1_verify"]

[node name="VerifyCargoTetherRuntime" type="Node"]
script = ExtResource("1_verify")
