[gd_resource type="StandardMaterial3D" format=3]

; Turret bodies. Warmer and darker than the asteroids so an emplacement reads as
; built rather than as another rock -- the player has no weapon, so spotting one
; early is the entire counterplay.

[resource]
albedo_color = Color(0.32, 0.2, 0.18, 1)
metallic = 0.4
roughness = 0.55
emission_enabled = true
emission = Color(0.7, 0.16, 0.1, 1)
emission_energy_multiplier = 0.5
