[gd_resource type="StandardMaterial3D" format=3]

; The dock ring. Emissive so it reads as a structure rather than as more rock,
; and so it is findable from a long way out in a scene lit by one sun.

[resource]
albedo_color = Color(0.18, 0.35, 0.42, 1)
metallic = 0.3
roughness = 0.5
emission_enabled = true
emission = Color(0.12, 0.62, 0.72, 1)
emission_energy_multiplier = 1.4
