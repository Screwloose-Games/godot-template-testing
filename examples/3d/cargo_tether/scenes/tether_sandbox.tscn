[node name="Rock5" type="AnimatableBody3D" parent="Rocks"]
transform = Transform3D(5, 0, 0, 0, 5, 0, 0, 0, 5, 10, 6, -150)
collision_layer = 1
collision_mask = 0

[node name="Mesh" type="MeshInstance3D" parent="Rocks/Rock5"]
mesh = SubResource("SphereMesh_rock")
