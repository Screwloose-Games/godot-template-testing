theme_override_font_sizes/font_size = 14
text = "CAMERA   WASD / arrows / screen edge — pan
         Wheel — zoom     Middle-drag — pan
SELECT   Click select     Drag box-select
         Shift+click add  Ctrl+click remove
         Double-click — all of type on screen
         Ctrl+1..4 set group    1..4 recall
ORDERS   Right-click ground — move (always obeyed)
         Ctrl+right-click — attack-move
         Right-click enemy — attack
         Right-click with HQ selected — rally
BUILD    Z Grunt    X Archer    C Tank
OTHER    F centre selection   Space centre HQ
         H hide this panel    Esc pause"

