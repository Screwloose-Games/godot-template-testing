[gd_scene load_steps=4 format=3]

; Both camera rigs plus the switch between them, as one node for the world scene to
; instance. A scene that wants a camera adds this and wires `target` and `marker`;
; it never needs to know that there are two rigs behind it.
;
; The rigs are CHILDREN OF THE DIRECTOR and therefore siblings of the creature. A
; camera parented to the creature inherits its rotation, and this one writhes.
;
; The two rigs are instanced sub-scenes, so their internal %SpringArm and %Camera
; unique names are registered against their own roots and do not collide with each
; other -- unique names resolve against a node's `owner`, not by walking the tree.

[ext_resource type="Script" path="crawler_camera_director.gd" id="1_director"]
[ext_resource type="PackedScene" path="crawler_chase_rig.tscn" id="2_chase"]
[ext_resource type="PackedScene" path="crawler_orbit_rig.tscn" id="3_orbit"]

[node name="CrawlerCameraDirector" type="Node3D"]
script = ExtResource("1_director")

[node name="ChaseRig" parent="." instance=ExtResource("2_chase")]
unique_name_in_owner = true

[node name="OrbitRig" parent="." instance=ExtResource("3_orbit")]
unique_name_in_owner = true
