[gd_scene load_steps=3 format=3]

; The tentacle geometry. Two nodes: the ribbons themselves, and the pads where they
; grip.
;
; BOTH ARE top_level AND HELD AT IDENTITY by the script. Everything they draw is
; computed in world space, so inheriting the creature's transform would apply it
; twice -- and because the creature writhes, the error would be a rotation, which
; reads as the tentacles swimming around the body rather than growing out of it.
;
; The material here is built in _ready() rather than assigned from
; materials/tentacle.tres, because the ribbon needs vertex_color_use_as_albedo to
; carry the per-strand stroke pulse. The .tres carries the same settings so they stay
; documented and diffable in one place.

[ext_resource type="Script" path="tentacle_ribbons.gd" id="1_ribbons"]
[ext_resource type="Material" path="../../materials/anchor_pad.tres" id="2_pad"]

[node name="TentacleRibbons" type="MeshInstance3D"]
script = ExtResource("1_ribbons")

[node name="AnchorPads" type="MultiMeshInstance3D" parent="."]
unique_name_in_owner = true
material_override = ExtResource("2_pad")
cast_shadow = 0
