{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/gameplay-loops.schema.json",
  "title": "Gameplay Loop Document",
  "description": "A generalized, machine-validatable description of a game's gameplay loops across tiers, the resources that flow through them, and how loops feed one another.",
  "type": "object",
  "required": ["schema_version", "game", "resources", "loops"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Format version, e.g. \"1.0\"."
    },
    "game": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "genre": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "resources": {
      "type": "array",
      "description": "Canonical resource definitions. Everything a loop consumes or produces must be declared here and referenced by id.",
      "items": { "$ref": "#/$defs/resource" }
    },
    "loops": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/loop" }
    }
  },

  "$defs": {
    "slug": {
      "type": "string",
      "description": "Lowercase snake_case identifier used for cross-references.",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },

    "resource": {
      "type": "object",
      "required": ["id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "description": "What kind of thing flows. Drives economy analysis.",
          "enum": [
            "currency",
            "consumable",
            "material",
            "stat",
            "progression",
            "unlock",
            "information",
            "time",
            "other"
          ]
        },
        "persistence": {
          "type": "string",
          "description": "How long the resource survives. ephemeral=within a loop iteration, run=until the run ends, session=until the play session ends, meta=persists forever.",
          "enum": ["ephemeral", "run", "session", "meta"],
          "default": "run"
        },
        "description": { "type": "string" }
      }
    },

    "resource_ref": {
      "type": "object",
      "required": ["resource"],
      "additionalProperties": false,
      "properties": {
        "resource": { "$ref": "#/$defs/slug" },
        "amount": {
          "type": ["number", "string"],
          "description": "Fixed amount (number) or an expression/range as text, e.g. \"1-3\" or \"scales_with_depth\"."
        },
        "note": { "type": "string" }
      }
    },

    "loop": {
      "type": "object",
      "required": ["id", "name", "tier", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "tier": {
          "type": "string",
          "description": "Time-scale of the loop. core=moment-to-moment, session=a run/session, meta=long-term progression.",
          "enum": ["core", "session", "meta"]
        },
        "cadence": {
          "type": "string",
          "description": "Human-readable duration of one iteration, e.g. \"5-30s\", \"10-25 min\"."
        },
        "est_seconds": {
          "type": "object",
          "description": "Optional numeric estimate of one iteration, for programmatic tier comparison.",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "intent": {
          "type": "string",
          "description": "The player fantasy / motivation this loop serves. Why the player keeps doing it."
        },
        "trigger": {
          "type": "string",
          "description": "Entry condition that starts an iteration."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "exit": {
          "type": "array",
          "description": "Edges that leave the loop. Omit for a loop that only ever cycles.",
          "items": { "$ref": "#/$defs/exit" }
        },
        "feeds": {
          "type": "array",
          "description": "Which other loops this loop hands resources/control to.",
          "items": { "$ref": "#/$defs/feed" }
        }
      }
    },

    "step": {
      "type": "object",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "A player verb phrase: what happens at this beat."
        },
        "consumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_ref" }
        },
        "produces": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource_ref" }
        },
        "feedback": {
          "type": "string",
          "description": "What the player perceives here (juice, information, reward signal)."
        },
        "next": {
          "type": "array",
          "description": "Step ids reachable from here. Omit to default to the next step in array order; the final step defaults to the loop's first step (closing the cycle). Multiple entries model a branch.",
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },

    "exit": {
      "type": "object",
      "required": ["condition"],
      "additionalProperties": false,
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "to": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "description": "Loop id control transfers to, or null to return to the parent/caller."
        }
      }
    },

    "feed": {
      "type": "object",
      "required": ["loop"],
      "additionalProperties": false,
      "properties": {
        "loop": { "$ref": "#/$defs/slug" },
        "via": {
          "type": "array",
          "description": "Resource ids that carry across this feed.",
          "items": { "$ref": "#/$defs/slug" }
        },
        "note": { "type": "string" }
      }
    }
  }
}
